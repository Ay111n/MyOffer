# Backend
SESSION_SECRET=dev-only-change-me
# production 时 SESSION_SECRET 必须显式设置（默认值拒绝启动）；
# production 且 COOKIE_SECURE=false 时还必须显式 ALLOW_INSECURE_COOKIE=1，
# 否则拒绝启动（backend/app/config.py::_production_guardrails）
ENV=development
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_DAYS=2
MAX_SESSIONS=200
MAX_IDENTITIES=200
MEMORY_DB_MAX_MB=96
DB_GATE_TIMEOUT_SECONDS=8
LOG_LEVEL=INFO
TELEMETRY_ENABLED=false
TELEMETRY_RETENTION_HOURS=24
TELEMETRY_MAX_PER_SESSION=200
TELEMETRY_MAX_TOTAL=10000

# 进程内限流（单实例有效；多实例部署各实例独立计数）
RATE_LIMIT_SESSIONS_PER_MINUTE=30
RATE_LIMIT_TELEMETRY_PER_MINUTE=120

# Frontend（Next.js 代理目标：/api/* 转发到后端）
# 注意：后端不读取本项（config.py extra=ignore），仅部署脚本与文档使用。
# 另注意：next dev 只读取 frontend/ 目录下的 .env*——把本文件复制到仓库根后，
# 修改这里的 BACKEND_ORIGIN 不会影响 dev 代理；要改代理目标请同步修改
# frontend/.env.local（不设置时代理回落 http://localhost:8000）。
BACKEND_ORIGIN=http://localhost:8000
