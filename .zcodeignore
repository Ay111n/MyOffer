# Local secrets and environment overrides
.env
.env.*
!.env.example

# Python runtime artifacts
**/__pycache__/
*.py[cod]
*.egg-info/
**/.venv/
.pytest_cache/
.ruff_cache/

# Frontend dependencies and build output
frontend/node_modules/
frontend/.next/
frontend/out/
*.tsbuildinfo

# Local logs and editor metadata
*.log
.idea/
.vscode/

# Test artifacts
gui-test-screenshots/
frontend/test-results/
frontend/playwright-report/
frontend/coverage/

# Local design handoff material (screenshots / briefs / exported bundles)
design-handoff/

# Generated API schema (regenerated by scripts/export_openapi.py)
**/openapi.json

# AI agent scratch
.zcode/
.workbuddy/
.workbuddy-ai/

# Stale experimental builds / one-off debug artifacts
frontend/fe-n*/
frontend/evidence-*.png
frontend/check-home-banner.cjs

# OS / editor scratch
.DS_Store
Thumbs.db
*.bak
*.tmp
*.swp

