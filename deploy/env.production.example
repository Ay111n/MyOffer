# MyOffer 生产环境变量模板（2C/2GB/1Mbps · 无域名仅有公网 IP）
#
# 用法：
#   cp deploy/env.production.example /srv/myoffer/.env
#   # 生成会话密钥后填入
#   SESSION_SECRET=$(openssl rand -hex 32)
#
# 放置位置（backend/app/config.py 的 env_file 搜索顺序）：
#   <backend 工作目录>/.env  或  <仓库根>/.env
# systemd 场景建议放 /srv/myoffer/.env，由 EnvironmentFile 注入。

# ── 运行环境 ──────────────────────────────────────────────────────────
ENV=production
# ⚠️ 护栏（backend/app/config.py::_production_guardrails）：
#    ENV=production 且 SESSION_SECRET 为默认值 dev-only-change-me 时，**应用拒绝启动**。
#    SESSION_SECRET 必须显式设置。
SESSION_SECRET=REPLACE_ME_openssl_rand_hex_32
# 用于 HMAC-SHA256 token 摘要；至少 32 字符。修改后旧 Cookie 失效。

# ⚠️ 无域名/无证书时必须为 false：置 true 后浏览器在 HTTP 下不会回传 Cookie，
#    所有接口都会 401。补上证书后改为 true（同时 nginx 开 TLS）。
COOKIE_SECURE=false

# ⚠️ 生产 + HTTP 的显式确认开关：COOKIE_SECURE=false 时必须同时置 1，
#    否则应用拒绝启动（防止"忘了配 HTTPS"静默上线）。
#    补上证书后：COOKIE_SECURE=true 并删除本行。
ALLOW_INSECURE_COOKIE=1

# ── CORS ─────────────────────────────────────────────────────────────
# 静态导出 + nginx 同源反代 /api 时前后端同源，浏览器不发 CORS 预检，
# 本项实际不生效；填公网 IP 只为兜底直连后端的场景。
CORS_ORIGINS=http://REPLACE_ME_PUBLIC_IP

# 开发和部署脚本使用该地址访问本机后端；用 127.0.0.1 避免 IPv6 解析差异。
BACKEND_ORIGIN=http://127.0.0.1:8000

# ── 限流（进程内计数；单实例有效，多 worker 会各算一份）─────────────
RATE_LIMIT_SESSIONS_PER_MINUTE=30
RATE_LIMIT_TELEMETRY_PER_MINUTE=30

# 状态在重启时清空；闲置 2 天或达到总量上限时回收最旧访问状态。
SESSION_TTL_DAYS=2
MAX_SESSIONS=200
MAX_IDENTITIES=200
MEMORY_DB_MAX_MB=96
DB_GATE_TIMEOUT_SECONDS=8
LOG_LEVEL=INFO
# 暂无正式分析消费者，默认关闭；开启时最多保留一天且受行数限制。
TELEMETRY_ENABLED=false
TELEMETRY_RETENTION_HOURS=24
TELEMETRY_MAX_PER_SESSION=200
TELEMETRY_MAX_TOTAL=10000
