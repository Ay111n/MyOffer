# Local secrets and environment overrides
.env
.env.*
!.env.example

# Python runtime artifacts
**/__pycache__/
*.py[cod]
*.egg-info/
**/.venv/
.pytest_cache/
.ruff_cache/
.tmp-runtime/

# Frontend dependencies and build output
frontend/node_modules/
backend/ai-runtime/node_modules/
frontend/.next/
frontend/out/
*.tsbuildinfo

# Local logs and editor metadata
*.log
.idea/
.vscode/

# Test artifacts
gui-test-screenshots/
frontend/test-results/
frontend/playwright-report/
frontend/coverage/

# Local design handoff material (screenshots / briefs / exported bundles)
design-handoff/

# Generated API schema (regenerated by backend/app/export_openapi.py)
# 两份契约入库：CI 用「现生成 vs 入库」做漂移检查，前端 gen:api 读 backend 那份。
# .zcodeignore 仍排除它们——开源发布树不含生成物。
**/openapi.json
!/openapi.json
!/backend/openapi.json

# AI agent scratch
.zcode/
.workbuddy/
.workbuddy-ai/

# Stale experimental builds / one-off debug artifacts
frontend/fe-n*/
frontend/evidence-*.png
frontend/check-home-banner.cjs

# OS / editor scratch
.DS_Store
Thumbs.db
*.bak
*.tmp
*.swp

# 内部调研与策略报告，不随开源仓库发布
reports/
